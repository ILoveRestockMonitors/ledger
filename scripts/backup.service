[Unit]
Description=Encrypted Ledger data backup
Wants=ledger.service
After=ledger.service

[Service]
Type=oneshot
User=ledger
Group=ledger
WorkingDirectory=/opt/ledger
EnvironmentFile=-/etc/ledger/ledger.env
ExecStart=/usr/bin/python3 /opt/ledger/scripts/backup.py backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# The default external mount is optional; the '-' prefix lets the unit load
# before it is mounted. Add a drop-in for a different configured mount.
ReadWritePaths=/var/lib/ledger -/mnt/ledger-backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
